# توسعه محلی: Postgres روی میزبان و پورت 5437 است.
# Production: فایل .env.production.example را ببینید (POSTGRES_HOST=postgres و پورت 5432).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5437
POSTGRES_DB=management_db
POSTGRES_USER=management
POSTGRES_PASSWORD=management
DATABASE_URL=postgresql://management:management@127.0.0.1:5437/management_db
# کاربر جاری ابزارهای MCP. در mcp.json سرورهای management هم همین را بگذارید.
MCP_ACTOR_USER_ID=
MCP_ACTOR_USERNAME=
# زمین بازی و سرور STT از Google Web Speech با زبان fa-IR استفاده می‌کند.
# ffmpeg باید در PATH باشد.
# API وب و موبایل: python -m hub
# 0.0.0.0 تا گوشی روی همان شبکه به API برسد. 127.0.0.1 فقط خود همین رایانه را می‌پذیرد.
API_HOST=0.0.0.0
API_PORT=8080
API_CORS_ORIGINS=*
API_SESSION_TTL_HOURS=336
API_DOMAINS=crud,meeting,finance,reminder,stats,stt,ner,nlp,embedding
