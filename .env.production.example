# کپی روی سرور: cp .env.production.example .env
# این فایل را commit نکنید. رمز را عوض کنید.

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=management_db
POSTGRES_USER=management
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://management:CHANGE_ME@postgres:5432/management_db

API_HOST=0.0.0.0
API_PORT=8080
API_CORS_ORIGINS=*
API_SESSION_TTL_HOURS=336
API_DOMAINS=crud,meeting,finance,reminder,stats,stt,ner,nlp,embedding
API_TOOL_TIMEOUT_SECONDS=300
API_MAX_BODY_BYTES=8388608

# همان کلید لپ‌تاپ را اینجا بگذارید (محلی معمولاً در ~/.cursor/mcp.json است).
# بدون این دو، استخراج متن و امبدینگ روی سرور خالی می‌ماند.
NLP_LLM_API_KEY=
AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1
AI_MODEL=deepseek-v4-flash
STT_MODEL=gpt-transcribe
EMBEDDING_MODEL=
